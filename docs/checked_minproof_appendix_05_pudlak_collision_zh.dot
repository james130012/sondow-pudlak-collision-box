    label="A05.04 参数化对角实例化\n通用固定证明与短数词实例化已检查",
    fillcolor="#dff2e8", color="#3f7c66"];
  assembly [node_id="A05.05", status="paper_conditional", endpoint_theorem="bounded proof assembly",
