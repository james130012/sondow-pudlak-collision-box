    label="A05.05 条件拼接：纸面推导已写出\n每次 MP 均计长；具体条件尚未建立",
    style="rounded,filled", fillcolor="#e1edf9", color="#47799e"];
  exponent [node_id="A05.06", status="paper_conditional", endpoint_theorem="Pudlak exponent extraction",
    source="planned", appendix="05", next_obligation="wait for A05.05",
    label="A05.06 条件反证与指数提取：纸面完成\n仍依赖具体定量条件和高效固定点",
