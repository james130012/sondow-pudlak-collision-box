    label="A05.03 具体定量条件【未完成】\n(0) 已纸面证明；(1)-(3) 等待独立证明",
    style="rounded,filled,dashed"];
  diagonal [node_id="A05.04", status="partial_done", endpoint_theorem="quantitative diagonal specialization",
    source="integration/FoundationCompactParameterizedDiagonalSpecialization.lean", appendix="05",
